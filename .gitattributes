# Floor-plan assets are copied verbatim from an upstream repo and verified by SHA-256 in
# tools/data-extraction/lc3/source/source-manifest.json. Collapse them in review — reading them
# line by line proves nothing that the hash check does not already prove.
frontend/public/maps/lc3/*.svg                    -diff linguist-vendored
tools/data-extraction/lc3/source/*.json           -diff linguist-vendored

# Written by data extraction tools. Review the generator, not the output.
tools/data-extraction/lc3/reports/*.csv         -diff linguist-generated=true
tools/data-extraction/lc3/survey/*.template.csv -diff linguist-generated=true
tools/data-extraction/lc3/*.seed.json            -diff linguist-generated=true
tools/data-extraction/lc3/*.seed.csv             -diff linguist-generated=true

# The dataset is UTF-8 with LF and must stay byte-stable across platforms, otherwise
# regenerating on Windows would produce a spurious diff against a Linux checkout.
*.csv  text eol=lf
*.json text eol=lf
*.mjs  text eol=lf
*.svg  text eol=lf

# The SHA-256 values in source-manifest.json are of the upstream committed blob, which is
# LF. `text eol=lf` above is therefore load-bearing, not cosmetic: it forces every working
# tree — Windows included, whatever core.autocrlf says — to hold the same bytes the hashes
# were taken over. Without it a Windows checkout gets CRLF and --verify-assets fails on data
# that is actually correct. Do not relax these to `-text` or `binary`.

# Editable Blender source for the 3D map (assets/3d/). Binary and ~6.5 MB per revision, so it
# lives in Git LFS. The exported GLB in frontend/ stays a normal blob: CD checks out without LFS.
assets/3d/**/*.blend filter=lfs diff=lfs merge=lfs -text
